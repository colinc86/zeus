# Copy to scripts/release.local.env (git-ignored) and fill in your own values.
# Your Developer ID Application certificate, exactly as `security find-identity -v -p codesigning` shows it.
ZEUS_SIGN_IDENTITY='Developer ID Application: Your Name (TEAMID1234)'
# The 10-character team ID from that certificate.
ZEUS_TEAM_ID=TEAMID1234
# A notarytool keychain profile: xcrun notarytool store-credentials <name> --apple-id <id> --team-id <team>
ZEUS_NOTARY_PROFILE=zeus-notary
